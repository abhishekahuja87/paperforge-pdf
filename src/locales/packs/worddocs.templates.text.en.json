        },
        {
          "h": "Who is responsible",
          "text": "[List the roles and what each one does.]",
          "level": 1,
          "table": {
            "headers": [
              "Role",
              "Responsibility"
            ],
            "rows": 4,
            "widths": [
              30,
              70
            ]
          },
          "id": "sop-2"
        },
        {
          "h": "Materials and tools",
          "text": "- [Item or tool needed]\n- [Item or tool needed]",
          "level": 1,
          "id": "sop-3"
        },
        {
          "h": "Procedure",
          "text": "[Write each step in order. Keep each step to one action.]\n\n- Step 1: [what to do]\n- Step 2: [what to do]\n- Step 3: [what to do]",
          "level": 1,
          "id": "sop-4"
        },
        {
          "h": "Safety and quality checks",
          "text": "- [What to check before starting]\n- [What to check when finished]",
          "level": 1,
          "id": "sop-5"
        },
        {
          "h": "Records to keep",
          "text": "[List the forms or logs to fill in, who keeps them and for how long, as your organisation decides.]",
          "level": 1,
          "id": "sop-6"
        },
        {
          "h": "Related documents",
          "text": "- [Other procedure or form]",
          "level": 1,
          "id": "sop-7"
        },
        {
          "h": "Revision history",
          "text": "[Record each change to this document.]",
          "level": 1,
          "table": {
            "headers": [
              "Version",
              "Date",
              "Changed by",
              "What changed"
            ],
            "rows": 4,
            "widths": [
              14,
              20,
              26,
              40
            ]
          },
          "id": "sop-8"
        }
      ],
      "id": "sop"
    },
