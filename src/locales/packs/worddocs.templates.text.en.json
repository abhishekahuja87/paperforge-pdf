  "templates": {
    "project-proposal": {
      "file": "project-proposal",
      "title": "Project Proposal",
      "subtitle": "[Project name]",
      "sections": [
        {
          "h": "Executive summary",
          "text": "[Write two or three sentences: what the project is, who it is for, what it will cost and how long it will take. Write this last.]",
          "level": 1,
          "id": "project-proposal-0"
        },
        {
          "h": "Background and problem",
          "text": "[Describe the situation today and the problem or opportunity this project deals with. Say why it matters now.]",
          "level": 1,
          "id": "project-proposal-1"
        },
        {
          "h": "Objectives",
          "text": "- [Objective 1: what you want to achieve]\n- [Objective 2]\n- [Objective 3]",
          "level": 1,
          "id": "project-proposal-2"
        },
        {
          "h": "Scope",
          "text": "[Say what the project will cover.]",
          "level": 1,
          "id": "project-proposal-3"
        },
        {
          "h": "In scope",
          "text": "- [Work that is included]\n- [Work that is included]",
          "level": 2,
          "id": "project-proposal-4"
        },
        {
          "h": "Out of scope",
          "text": "- [Work that is not included, so nobody expects it]",
          "level": 2,
          "id": "project-proposal-5"
        },
        {
          "h": "Approach",
          "text": "[Explain how you will do the work: the steps, methods and tools, and why this approach suits the project.]",
          "level": 1,
          "id": "project-proposal-6"
        },
        {
          "h": "Deliverables",
          "text": "[List what will be handed over and when.]",
          "level": 1,
          "table": {
            "headers": [
              "Deliverable",
              "Description",
              "Due date"
            ],
            "rows": 4,
            "widths": [
              30,
              50,
              20
            ]
          },
          "id": "project-proposal-7"
        },
        {
          "h": "Timeline",
          "text": "[Show the main phases and their dates.]",
          "level": 1,
          "table": {
            "headers": [
              "Phase",
              "Activities",
              "Start",
              "End"
            ],
            "rows": 5,
            "widths": [
              22,
              46,
              16,
              16
            ]
          },
          "id": "project-proposal-8"
        },
        {
          "h": "Team and roles",
          "text": "[Say who will do what.]",
          "level": 1,
          "table": {
            "headers": [
              "Name",
              "Role",
              "Responsibility"
            ],
            "rows": 4,
            "widths": [
              28,
              24,
              48
            ]
          },
          "id": "project-proposal-9"
        },
        {
          "h": "Budget",
          "text": "[List the costs. Add a total at the bottom.]",
          "level": 1,
          "table": {
            "headers": [
              "Item",
              "Details",
              "Cost"
            ],
            "rows": 6,
            "widths": [
              30,
              48,
              22
            ]
          },
          "id": "project-proposal-10"
        },
        {
          "h": "Risks",
          "text": "[List what could go wrong and what you will do about it.]",
          "level": 1,
          "table": {
            "headers": [
              "Risk",
              "Likelihood",
              "Impact",
              "Plan to handle it"
            ],
            "rows": 4,
            "widths": [
              30,
              14,
              14,
              42
            ]
          },
          "id": "project-proposal-11"
        },
        {
          "h": "How success will be measured",
          "text": "- [Measure 1: what will you count or check]\n- [Measure 2]",
          "level": 1,
          "id": "project-proposal-12"
        },
        {
          "h": "Next steps and approval",
          "text": "[Say what happens next and who needs to approve the proposal.]",
          "level": 1,
          "id": "project-proposal-13"
        }
      ],
      "id": "project-proposal"
    },
    "project-report": {
      "file": "project-report",
      "title": "Project Report",
      "subtitle": "[Project name]",
      "sections": [
        {
          "h": "Summary",
          "text": "[Give a short summary of the project, the main results and the main recommendation. Write this last.]",
          "level": 1,
          "id": "project-report-0"
        },
        {
          "h": "Introduction",
          "text": "[Say what the project was, why it was done and who it was for.]",
          "level": 1,
          "id": "project-report-1"
        },
        {
          "h": "Objectives",
          "text": "- [Objective 1]\n- [Objective 2]\n- [Objective 3]",
          "level": 1,
          "id": "project-report-2"
        },
        {
          "h": "Work done",
          "text": "[Describe the work in the order it happened.]",
          "level": 1,
          "id": "project-report-3"
        },
        {
          "h": "Phase 1: [name]",
          "text": "[What was done, by whom and when.]",
          "level": 2,
          "id": "project-report-4"
        },
        {
          "h": "Phase 2: [name]",
          "text": "[What was done, by whom and when.]",
          "level": 2,
          "id": "project-report-5"
        },
        {
          "h": "Results and findings",
          "text": "[Describe what the project achieved. Use numbers where you can.]\n\n- [Result 1]\n- [Result 2]",
          "level": 1,
          "id": "project-report-6"
        },
        {
          "h": "Challenges and how they were handled",
          "text": "[Describe the main problems and what you did about them.]",
          "level": 1,
          "id": "project-report-7"
        },
        {
          "h": "Budget and spending",
          "text": "[Compare what was planned with what was spent.]",
          "level": 1,
          "table": {
            "headers": [
              "Item",
              "Planned",
              "Actual",
              "Difference"
            ],
            "rows": 6,
            "widths": [
              34,
              22,
              22,
              22
            ]
          },
          "id": "project-report-8"
        },
        {
          "h": "Lessons learned",
          "text": "- [What went well]\n- [What could be done better next time]",
          "level": 1,
          "id": "project-report-9"
        },
        {
          "h": "Recommendations",
          "text": "[Say what should happen next, and who should do it.]",
          "level": 1,
          "id": "project-report-10"
        },
        {
          "h": "Conclusion",
          "text": "[Close with a short statement of what was achieved.]",
          "level": 1,
          "id": "project-report-11"
        },
        {
          "h": "Appendix",
          "text": "[Add extra material here: data, photos, letters or other documents.]",
          "level": 1,
          "id": "project-report-12"
        }
      ],
      "id": "project-report"
    },
    "business-plan": {
      "file": "business-plan",
      "title": "Business Plan",
      "subtitle": "[Business name]",
      "sections": [
        {
          "h": "Executive summary",
          "text": "[Summarise the business, what it sells, who it sells to, how much money it needs and what it expects. Write this last.]",
          "level": 1,
          "id": "business-plan-0"
        },
        {
          "h": "Business description",
          "text": "[Say what the business does, where it is based, its legal form (as you have chosen it) and why you are starting it.]",
          "level": 1,
          "id": "business-plan-1"
        },
        {
          "h": "Products or services",
          "text": "[Describe what you sell, what makes it useful and how it is priced.]",
          "level": 1,
          "id": "business-plan-2"
        },
        {
          "h": "Market and customers",
          "text": "[Describe who your customers are, how many there are and what they need.]",
          "level": 1,
          "id": "business-plan-3"
        },
        {
          "h": "Competition",
          "text": "[List the main competitors and say how you are different.]",
          "level": 1,
          "table": {
            "headers": [
              "Competitor",
              "What they do well",
              "Where we are better"
            ],
            "rows": 3,
            "widths": [
              28,
              36,
              36
            ]
          },
          "id": "business-plan-4"
        },
        {
          "h": "Marketing and sales plan",
          "text": "[Say how customers will find you and how you will sell to them.]",
          "level": 1,
          "id": "business-plan-5"
        },
        {
          "h": "Operations",
          "text": "[Describe the place, equipment, suppliers and how the work gets done each day.]",
          "level": 1,
          "id": "business-plan-6"
        },
        {
          "h": "Team",
          "text": "[Introduce the people who will run the business and what each one does.]",
          "level": 1,
          "table": {
            "headers": [
              "Name",
              "Role",
              "Experience"
            ],
            "rows": 3,
            "widths": [
              28,
              24,
              48
            ]
          },
          "id": "business-plan-7"
        },
        {
          "h": "Financial plan",
          "text": "[Show what you expect to earn and spend. Use your own figures.]",
          "level": 1,
          "table": {
            "headers": [
              "Item",
              "Month 1-3",
              "Month 4-6",
              "Month 7-12"
            ],
            "rows": 6,
            "widths": [
              34,
              22,
              22,
              22
            ]
          },
          "id": "business-plan-8"
        },
        {
          "h": "Funding needed and how it will be used",
          "text": "[Say how much money you need, where it will come from and what it will be spent on.]",
          "level": 1,
          "id": "business-plan-9"
        },
        {
          "h": "Risks",
          "text": "[List the main risks and what you will do about them.]",
          "level": 1,
          "id": "business-plan-10"
        },
        {
          "h": "Milestones",
          "text": "[List the main steps and when you plan to reach them.]",
          "level": 1,
          "table": {
            "headers": [
              "Milestone",
              "Target date"
            ],
            "rows": 5,
            "widths": [
              70,
              30
            ]
          },
          "id": "business-plan-11"
        }
      ],
      "id": "business-plan"
    },
    "sop": {
      "file": "sop",
      "title": "Standard Operating Procedure",
      "subtitle": "[Name of the procedure]",
      "sections": [
        {
          "h": "Purpose",
          "text": "[Say why this procedure exists and what it makes sure of.]",
          "level": 1,
          "id": "sop-0"
        },
        {
          "h": "Scope",
          "text": "[Say who and what this procedure applies to, and where it does not apply.]",
          "level": 1,
